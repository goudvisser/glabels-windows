diff --git a/glabels/PrintView.cpp b/glabels/PrintView.cpp
--- a/glabels/PrintView.cpp
+++ b/glabels/PrintView.cpp
@@ -27,6 +27,146 @@
 #include <QPrinterInfo>
 #include <QPrintDialog>
 
+#ifdef Q_OS_WIN
+#ifndef NOMINMAX
+#define NOMINMAX
+#endif
+#include <windows.h>
+#include <commctrl.h>
+#endif
+
+namespace
+{
+#ifdef Q_OS_WIN
+        HWND gCopiesEdit = nullptr;
+        HWND gCopiesSpinner = nullptr;
+        WNDPROC gOldCopiesEditProc = nullptr;
+
+        BOOL CALLBACK findCopiesControls( HWND hwnd, LPARAM )
+        {
+                if ( GetDlgCtrlID(hwnd) == 0x481 )
+                {
+                        gCopiesEdit = hwnd;
+                }
+
+                wchar_t className[64] = {};
+                GetClassNameW( hwnd, className, 64 );
+
+                if ( lstrcmpiW(className, L"msctls_updown32") == 0 )
+                {
+                        HWND buddy = reinterpret_cast<HWND>(
+                                SendMessageW( hwnd, UDM_GETBUDDY, 0, 0 ) );
+
+                        if ( buddy && GetDlgCtrlID(buddy) == 0x481 )
+                        {
+                                gCopiesEdit = buddy;
+                                gCopiesSpinner = hwnd;
+                        }
+                }
+
+                return TRUE;
+        }
+
+        LRESULT CALLBACK copiesEditProc( HWND hwnd,
+                                         UINT msg,
+                                         WPARAM wParam,
+                                         LPARAM lParam )
+        {
+                if ( msg == WM_CHAR &&
+                     wParam >= L'0' &&
+                     wParam <= L'9' &&
+                     gCopiesSpinner )
+                {
+                        wchar_t text[16] = {};
+                        GetWindowTextW( hwnd, text, 16 );
+
+                        DWORD start = 0;
+                        DWORD end = 0;
+                        SendMessageW( hwnd,
+                                      EM_GETSEL,
+                                      reinterpret_cast<WPARAM>(&start),
+                                      reinterpret_cast<LPARAM>(&end) );
+
+                        const int length = lstrlenW( text );
+
+                        if ( length == 3 && start == 3 && end == 3 )
+                        {
+                                const int value =
+                                        (text[0] - L'0') * 1000 +
+                                        (text[1] - L'0') * 100 +
+                                        (text[2] - L'0') * 10 +
+                                        (wParam - L'0');
+
+                                if ( value >= 1000 && value <= 9999 )
+                                {
+                                        SendMessageW( gCopiesSpinner,
+                                                      UDM_SETPOS32,
+                                                      0,
+                                                      value );
+                                        return 0;
+                                }
+                        }
+                }
+
+                return CallWindowProcW(
+                        gOldCopiesEditProc, hwnd, msg, wParam, lParam );
+        }
+
+        LRESULT CALLBACK copiesDialogHook( int code,
+                                           WPARAM wParam,
+                                           LPARAM lParam )
+        {
+                if ( code == HCBT_ACTIVATE && !gOldCopiesEditProc )
+                {
+                        gCopiesEdit = nullptr;
+                        gCopiesSpinner = nullptr;
+
+                        EnumChildWindows(
+                                reinterpret_cast<HWND>(wParam),
+                                findCopiesControls,
+                                0 );
+
+                        if ( gCopiesEdit && gCopiesSpinner )
+                        {
+                                gOldCopiesEditProc =
+                                        reinterpret_cast<WNDPROC>(
+                                                SetWindowLongPtrW(
+                                                        gCopiesEdit,
+                                                        GWLP_WNDPROC,
+                                                        reinterpret_cast<LONG_PTR>(
+                                                                copiesEditProc ) ) );
+                        }
+                }
+
+                return CallNextHookEx( nullptr, code, wParam, lParam );
+        }
+#endif
+
+        int execPrintDialogWithCopiesFix( QPrintDialog& printDialog )
+        {
+#ifdef Q_OS_WIN
+                HHOOK copiesHook =
+                        SetWindowsHookExW( WH_CBT,
+                                          copiesDialogHook,
+                                          nullptr,
+                                          GetCurrentThreadId() );
+
+                const int result = printDialog.exec();
+
+                if ( copiesHook )
+                {
+                        UnhookWindowsHookEx( copiesHook );
+                }
+
+                gCopiesEdit = nullptr;
+                gCopiesSpinner = nullptr;
+                gOldCopiesEditProc = nullptr;
+                return result;
+#else
+                return printDialog.exec();
+#endif
+        }
+}
 
 namespace glabels
 {

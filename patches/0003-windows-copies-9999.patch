                 printDialog.setOption( QAbstractPrintDialog::PrintCurrentPage,   false );
-                if ( printDialog.exec() == QDialog::Accepted )
+                if ( execPrintDialogWithCopiesFix(printDialog) == QDialog::Accepted )
                 {
